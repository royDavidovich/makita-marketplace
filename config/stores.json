[
  {
    "name": "Sample Store",
    "base_url": "https://www.example-store.co.il",
    "is_active": false,
    "selectors": {
      "priceSelector": ".product-price",
      "productUrlPattern": "/products/{model_number}",
      "searchUrlPattern": "https://www.example-store.co.il/search?q={model_number}",
      "productLinkSelector": ".product-item a"
    }
  },
  {
    "name": "KSP",
    "base_url": "https://ksp.co.il",
    "is_active": true,
    "selectors": {
      "searchUrlPattern": "https://ksp.co.il/web/cat/?search={model_number}",
      "productLinkSelector": "a[href^=\"/web/item/\"]",
      "searchPagePriceSelector": "[aria-label^=\"מחיר המוצר\"]"
    }
  },
  {
    "name": "MG Tools",
    "base_url": "https://www.mgtools.co.il",
    "is_active": true,
    "selectors": {
      "searchUrlPattern": "https://www.mgtools.co.il/search/?q={model_number}",
      "productLinkSelector": ".layout_list_item a",
      "priceSelector": "span.price_value"
    }
  }
]
